<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenCode is a Bun program. Under the hardened runtime a notarized app needs,
  Bun's JavaScript engine gets no JIT without these, and runs about six times
  slower (measured on OpenCode 2.0.20: 5.9 s against 0.95 s for the same loop).
  Library validation is off for the native modules it loads at run time.
  scripts/sign-bundled.mjs signs it with them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
