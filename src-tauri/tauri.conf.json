{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typst Studio",
  "version": "0.1.0",
  "identifier": "org.typststudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "resources": {
      "../samples/": "samples/"
    },
    "copyright": "© 2026 JJ Geewax",
    "publisher": "JJ Geewax"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMTBCOEE2RkQ5RjQyM0UKUldRK1FwLzlwcmdRYXRiSHNKajMvSjhWNWJSdDRGTzkwcUdZU2xSd2s5ZWRzdUhjQ3hZSUg3YWQK",
      "endpoints": [
        "https://github.com/jgeewax/typststudio/releases/latest/download/latest.json"
      ]
    }
  }
}
