{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "Tinymist's preview page (served from 127.0.0.1) may only report paint timings and diagnostics.",
  "webviews": ["*-preview"],
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "allow-perf-report",
    "allow-preview-report"
  ]
}
