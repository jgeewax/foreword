{
  "name": "typst-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "node scripts/bundle-opencode.mjs && node scripts/bundle-tinymist.mjs && tauri build --config src-tauri/tauri.bundle.json",
    "stress-book": "node scripts/gen-stress-book.mjs",
    "check-templates": "node scripts/check-templates.mjs",
    "icons": "tauri icon src-tauri/icons/app-icon.svg && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/64x64.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "monaco-editor": "0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.14.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
